// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "base_keymap": "VSCode",
  "file_scan_inclusions": ["node_modules/"],
  "sticky_scroll": { "enabled": true },
  "use_on_type_format": false,
  "format_on_save": "off",
  "ensure_final_newline_on_save": false,
  "remove_trailing_whitespace_on_save": false,
  "autosave": { "after_delay": { "milliseconds": 1000 } },
  "resize_all_panels_in_dock": ["left", "right"], // [] means every panel has its own size
  "project_panel": { "hide_root": true },
  "outline_panel": { "button": false },
  "collaboration_panel": { "button": false },
  "terminal": { "dock": "bottom" },
  "search": { "center_on_match": true, "button": false },
  "search_wrap": false,
  "debugger": { "button": false },
  "gutter": { "bookmarks": false, "breakpoints": false },
  "tabs": { "file_icons": true },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
    "show_nav_history_buttons": false,
  },

  "lsp": {
    "gopls": {
      "settings": {
        "usePlaceholders": false,
      },
    },
  },

  "theme": {
    "mode": "dark",
    "dark": "Zedokai (Filter Spectrum)",
    "light": "Zedokai Light (Filter Sun)",
  },
  "icon_theme": "Material Icon Theme",
  "ui_font_family": "Inter",
  "buffer_font_family": "JetBrains Mono",
  "ui_font_size": 18.0,
  "buffer_font_size": 19.0,
  "agent_ui_font_size": 18.0,
  "agent_buffer_font_size": 18.0,
  "ui_font_weight": 500.0,
  "buffer_font_weight": 400.0,
  "buffer_line_height": { "custom": 1.5 },

  "auto_install_extensions": {
    "material-icon-theme": true,
    "zedokai": true,
  },

  "disable_ai": true,
  "show_edit_predictions": false,

  "context_servers": {
    "duckduckgo": {
      "enabled": true,
      "remote": false,
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"],
      "env": {
        "DDG_SAFE_SEARCH": "OFF",
        "DDG_REGION": "wt-wt",
      },
    },
  },

  "language_models": {
    "opencode": {
      "show_free_models": false,
      "show_zen_models": false,
    },
  },

  "agent": {
    "flexible": false,
    "expand_terminal_card": false,
    "model_parameters": [{ "temperature": 0.0 }],
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow",
        },
        "mcp:duckduckgo:search": {
          "default": "allow",
        },
      },
    },
    "default_profile": "ask",
    "profiles": {
      "ask": {
        "name": "Ask",
        "default_model": {
          "provider": "opencode",
          "model": "go/deepseek-v4-pro",
          "enable_thinking": true,
          "effort": "max",
        },
        "tools": {
          "open": false,
          "terminal": true,
        },
        "enable_all_context_servers": true,
        "context_servers": {
          "duckduckgo": {
            "tools": {
              "fetch_content": false,
            },
          },
        },
      },
      "write": {
        "name": "Write",
        "default_model": {
          "provider": "opencode",
          "model": "go/deepseek-v4-flash",
          "enable_thinking": true,
          "effort": "max",
        },
        "tools": {
          "open": false,
          "restore_file_from_disk": false,
        },
        "enable_all_context_servers": true,
        "context_servers": {
          "duckduckgo": {
            "tools": {
              "fetch_content": false,
            },
          },
        },
      },
    },
    "default_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4-flash",
      "enable_thinking": true,
      "effort": "max",
    },
    "inline_assistant_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4-flash",
      "enable_thinking": false,
    },
    "commit_message_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4-flash",
      "enable_thinking": false,
    },
    "thread_summary_model": {
      "provider": "opencode",
      "model": "go/qwen3.5-plus",
      "enable_thinking": false,
    },
    "favorite_models": [
      {
        "provider": "opencode",
        "model": "go/deepseek-v4-flash",
        "enable_thinking": true,
        "effort": "max",
      },
      {
        "provider": "opencode",
        "model": "go/deepseek-v4-pro",
        "enable_thinking": true,
        "effort": "max",
      },
    ],
  },
}
